[Unit]
Description=Deploy a verified GitHub revision to EC2
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
EnvironmentFile=/etc/default/mate-ec2-deploy
ExecStart=/usr/bin/python3 /usr/local/libexec/mate-fastapi-pull-deploy.py ${GITHUB_DEPLOY_REPOSITORY} ${EC2_PROJECT_DIR}
